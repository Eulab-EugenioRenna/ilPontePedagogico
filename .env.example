# Copia questo file in `.env.local` per lo sviluppo con `npx vercel dev`.
# Su Vercel: Project → Settings → Environment Variables.

# --- Store prenotazioni (una coppia URL+TOKEN) ---------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
# oppure
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# oppure (nomi prefissati creati dall'integrazione Upstash su Vercel)
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
# NB: le variabili REDIS_URL / KV_URL (rediss://...) non sono REST e non servono.

# Forza lo store: di default Redis (obbligatorio in produzione/preview).
# Usa "memory" solo per sviluppo locale senza Redis.
BOOKING_STORE=

# --- Webhook appuntamenti ------------------------------------------
# Qui inserisci l'indirizzo che riceverà gli eventi (Make, Zapier, n8n, ...).
BOOKING_WEBHOOK_URL=
# Segreto opzionale, inviato come header "Authorization: Bearer <segreto>".
BOOKING_WEBHOOK_SECRET=

# --- Email notifiche (Resend) --------------------------------------
RESEND_API_KEY=
# Uno o più destinatari separati da virgola (prenotazioni).
BOOKING_NOTIFY_EMAIL=
# Destinatari del form di contatto (se vuoto usa BOOKING_NOTIFY_EMAIL).
CONTACT_NOTIFY_EMAIL=
# Mittente email (con Resend di test: onboarding@resend.dev).
BOOKING_FROM_EMAIL=
# Mittente del form di contatto (se vuoto usa BOOKING_FROM_EMAIL).
CONTACT_FROM_EMAIL=as

# --- Protezione pannello /appuntamenti -----------------------------
# Login con nome utente + password (consigliato).
ADMIN_USERNAME=noemi
ADMIN_PASSWORD=urboni
# Segreto per firmare i token di sessione (opzionale; default = ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=
# Durata della sessione in ore (default 12).
ADMIN_SESSION_HOURS=
# Token statico legacy (alternativo alle credenziali; per uso API).
ADMIN_ACCESS_TOKEN=
